      <div class="link-content">
        <div class="link-url"><a href="https://www.instagram.com/p/BOgKOZmg3eR/" target="_blank">https://www.instagram.com/p/BOgKOZmg3eR/</a></div>
        <div class='link-meta'>@jcquipos1, liked Dec 26, 2016</div>
      </div>
    </div>
  </div></div>
</section>
<script>
(function(){
  var sec=document.getElementById('accounts--channels'), cur='';
  function apply(tag){
    cur=tag;
    sec.querySelectorAll('#accFilter .tag').forEach(function(b){b.classList.toggle('on',b.dataset.tag===tag)});
    sec.querySelectorAll('.acc-item').forEach(function(el){
      el.style.display=(!tag||el.dataset.tags.split('|').indexOf(tag)>-1)?'':'none';
    });
    sec.querySelectorAll('.acc-group').forEach(function(g){
      var any=[].some.call(g.querySelectorAll('.acc-item'),function(el){return el.style.display!=='none'});
      g.style.display=any?'':'none';
    });
  }
  sec.addEventListener('click',function(e){
    var b=e.target.closest('.tag'); if(!b) return;
    var inCard=!!b.closest('.acc-tags');
    apply(inCard&&b.dataset.tag===cur?'':b.dataset.tag);
    if(inCard) sec.scrollIntoView({behavior:'smooth'});
  });
})();
</script>
<script>
(function(){
  var KEY='igsaved-ops-v1', ops=[];
  try{ops=JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){ops=[]}
  var baked=+(document.documentElement.getAttribute('data-baked')||0);
  function persist(){try{localStorage.setItem(KEY,JSON.stringify(ops))}catch(e){} updateSave()}
  var $=function(s,r){return (r||document).querySelector(s)}, $$=function(s,r){return [].slice.call((r||document).querySelectorAll(s))};
  function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}

  /* ---------- keys ---------- */
  function postCode(u){var m=String(u).match(/instagram\.com\/(?:[^\/?#]+\/)?(?:p|reel|reels|tv)\/([^\/?#\s]+)/i);return m?m[1].slice(0,11):null}
  function handleFrom(u){
    u=String(u||'').trim(); if(!u) return null;
    var m=u.match(/instagram\.com\/(?:_u\/)?([^\/?#\s]+)/i);
    var h=(m?m[1]:u).replace(/^@/,'').replace(/\/+$/,'').toLowerCase();
    if(['p','reel','reels','tv','stories','explore','_u'].indexOf(h)>-1) return null;
    return /^[a-z0-9._]{1,30}$/.test(h)?h:null;
  }
  function ownerFrom(u){var m=String(u).match(/instagram\.com\/([^\/?#]+)\/(?:p|reel|reels|tv)\//i);return m?m[1].toLowerCase():''}
  function keyOf(u){var c=postCode(u);if(c)return 'post:'+c;var h=handleFrom(u);return h?'acc:'+h:null}
  function itemKey(el){var a=el.querySelector('.link-url a, .acc-handle a');return a?keyOf(a.getAttribute('href')):null}
  function itemsByKey(k){return $$('.link-item').filter(function(el){return itemKey(el)===k})}
  function sectionOf(el){return el.closest('section.category')}

  /* ---------- delete buttons ---------- */
  function addDel(el){
    if(el.querySelector(':scope > .del-btn')) return;
    var b=document.createElement('button');b.className='del-btn';b.type='button';b.title='Delete';b.setAttribute('aria-label','Delete');b.textContent='×';
    el.appendChild(b);
  }

  /* ---------- builders ---------- */
  function postEl(o){
    var d=document.createElement('div');d.className='link-item';
    d.innerHTML='<span class="link-num"></span><div class="link-content"><div class="link-url"><a href="'+esc(o.url)+'" target="_blank">'+esc(o.url)+'</a></div>'+
      (o.note?'<div class="link-caption" title="'+esc(o.note)+'">'+esc(o.note)+'</div>':'')+
      (o.handle?"<div class='link-meta'>@"+esc(o.handle)+'</div>':'')+'</div>';
    return d;
  }
  function tagBtns(t){return t.map(function(x){return '<button class="tag" data-tag="'+esc(x)+'">'+esc(x)+'</button>'}).join('')}
  function accEl(o){
    var d=document.createElement('div');d.className='link-item acc-item';d.setAttribute('data-tags',o.tags.join('|'));
    d.innerHTML='<span class="link-num"></span><div class="link-content"><div class="acc-handle"><a href="https://www.instagram.com/'+esc(o.handle)+'/" target="_blank">@'+esc(o.handle)+'</a></div>'+
      (o.desc?'<div class="acc-desc">'+esc(o.desc)+'</div>':'')+'<div class="acc-tags">'+tagBtns(o.tags)+'</div></div>';
    return d;
  }
  function accGroup(name,create){
    var sec=$('#accounts--channels'); if(!sec) return null;
    var g=$$('.acc-group',sec).filter(function(x){return x.querySelector('h3').firstChild.textContent.trim()===name})[0];
    if(g||!create) return g;
    g=document.createElement('div');g.className='acc-group';
    g.innerHTML='<h3>'+esc(name)+' <span class="acc-gcount">0</span></h3><div class="links-list"></div>';
    var rev=accGroup('To review',false);
    if(rev) rev.parentNode.insertBefore(g,rev); else sec.appendChild(g);
    return g;
  }

  /* ---------- apply ops ---------- */
  function apply(op){
    if(op.op==='del'){
      var els=itemsByKey(op.key).filter(function(el){var s=sectionOf(el);return !op.sec||(s&&s.id===op.sec)});
      els.forEach(function(el){el.remove()}); return els.length>0;
    }
    if(op.op==='addPost'){
      if(itemsByKey(keyOf(op.url)).length) return false;
      var sec=document.getElementById(op.sec); if(!sec) return false;
      var list=$('.links-list',sec); var el=postEl(op); addDel(el); list.insertBefore(el,list.firstChild); return true;
    }
    if(op.op==='addAcc'){
      if(itemsByKey('acc:'+op.handle).length) return false;
      var g=accGroup(op.group,true); if(!g) return false;
      var el2=accEl(op); addDel(el2); $('.links-list',g).appendChild(el2); return true;
    }
    return false;
  }

  /* ---------- counts ---------- */
  function refresh(){
    var postsTotal=0,accTotal=0,likedTotal=0;
    $$('section.category').forEach(function(sec){
      var items=$$('.link-item',sec), n=items.length;
      items.forEach(function(el,i){var s=el.querySelector('.link-num');if(s)s.textContent=i+1});
      var unit=sec.id==='accounts--channels'?'accounts':'posts';
      var cc=$('.cat-header .cat-count',sec); if(cc) cc.textContent=n+' '+unit;
      var toc=$('.toc a[href="#'+sec.id+'"] .toc-count'); if(toc) toc.textContent='('+n+')';
      if(sec.id==='accounts--channels') accTotal=n; else if(sec.id==='liked--backup') likedTotal=n; else postsTotal+=n;
      $$('.acc-group',sec).forEach(function(g){var k=$$('.link-item',g).length;var c=$('.acc-gcount',g);if(c)c.textContent=k;g.classList.toggle('hidden-ed',k===0)});
    });
    var sub=$('.subtitle');
    if(sub){var h=sub.innerHTML;
      h=h.replace(/^\s*[\d.,]+ posts/,postsTotal+' posts').replace(/[\d.,]+ accounts/,accTotal+' accounts').replace(/[\d.,]+ liked/,likedTotal+' liked');
      sub.innerHTML=h;}
    rebuildFilter();
  }
  function rebuildFilter(){
    var f=$('#accFilter'); if(!f) return;
    var cur=(f.querySelector('.tag.on')||{}).dataset; cur=cur?cur.tag:'';
    var seen={},list=[];
    $$('#accounts--channels .acc-item').forEach(function(el){(el.getAttribute('data-tags')||'').split('|').forEach(function(t){if(t&&!seen[t]){seen[t]=1;list.push(t)}})});
    var first=['not following now','backup','to review'].filter(function(t){return seen[t]});
    var rest=list.filter(function(t){return first.indexOf(t)<0}).sort(function(a,b){return a.toLowerCase().localeCompare(b.toLowerCase())});
    f.innerHTML='<button class="tag'+(cur?'':' on')+'" data-tag="">All</button>'+first.concat(rest).map(function(t){return '<button class="tag'+(t===cur?' on':'')+'" data-tag="'+esc(t)+'">'+esc(t)+'</button>'}).join('');
  }

  /* ---------- UI ---------- */
  var bar=document.createElement('div');bar.id='edBar';
  bar.innerHTML='<button type="button" id="edSave" data-n="0">Download updated file</button><button type="button" class="primary" id="edAdd">Add link</button>';
  document.body.appendChild(bar);
  var toast=document.createElement('div');toast.id='edToast';toast.innerHTML='<span></span><button type="button">Undo</button>';document.body.appendChild(toast);
  var dlg=document.createElement('dialog');dlg.id='edDlg';
  dlg.innerHTML='<form method="dialog">'+
    '<h2>Add link</h2>'+
    '<label>Instagram link or @account<input name="url" autocomplete="off" placeholder="https://www.instagram.com/reel/... or @account" required></label>'+
    '<div class="ed-kind"></div><div class="ed-warn"></div>'+
    '<div class="ed-post hidden-ed"><label>Category<select name="sec"></select></label>'+
      '<label style="margin-top:10px">Account (optional)<input name="handle" autocomplete="off" placeholder="@account"></label>'+
      '<label style="margin-top:10px">Note (optional)<textarea name="note" placeholder="What is it about"></textarea></label></div>'+
    '<div class="ed-acc hidden-ed"><label>Group<select name="group"></select></label>'+
      '<label class="ed-newgroup hidden-ed" style="margin-top:10px">New group name<input name="newgroup" autocomplete="off"></label>'+
      '<label style="margin-top:10px">Description (optional)<input name="desc" autocomplete="off"></label>'+
      '<label style="margin-top:10px">Tags, separated by commas<input name="tags" autocomplete="off" placeholder="history, maps"></label></div>'+
    '<div class="ed-foot"><button type="button" data-x>Cancel</button><button type="submit" class="primary" disabled>Add</button></div>'+
  '</form>';
  document.body.appendChild(dlg);
  var form=dlg.querySelector('form'), kind=null;

  function fillSelects(){
    var s=form.sec; s.innerHTML='';
    $$('section.category').forEach(function(sec){
      if(sec.id==='accounts--channels'||sec.id==='liked--backup') return;
      var t=$('.cat-title',sec); if(t) s.add(new Option(t.textContent,sec.id));
    });
    var g=form.group; g.innerHTML='';
    $$('#accounts--channels .acc-group h3').forEach(function(h){var n=h.firstChild.textContent.trim();g.add(new Option(n,n))});
    g.add(new Option('New group…','__new'));
  }
  function check(){
    var v=form.url.value, k=keyOf(v), warn='', ok=false;
    kind=k?k.split(':')[0]:null;
    dlg.querySelector('.ed-post').classList.toggle('hidden-ed',kind!=='post');
    dlg.querySelector('.ed-acc').classList.toggle('hidden-ed',kind!=='acc');
    dlg.querySelector('.ed-kind').textContent=kind==='post'?'This is a post. It will go into your saved posts.':kind==='acc'?'This is an account. It will go into Accounts & Channels.':'';
    if(v.trim()&&!k) warn='That does not look like an Instagram link or account.';
    if(k){
      var ex=itemsByKey(k);
      if(ex.length){var s=sectionOf(ex[0]);warn='Already in the file, under '+(s?$('.cat-title',s).textContent:'another section')+'.'}
      else ok=true;
    }
    if(kind==='post'&&!form.handle.value){var o=ownerFrom(v);if(o)form.handle.value='@'+o}
    if(kind==='acc'&&form.group.value==='__new'&&!form.newgroup.value.trim()) ok=false;
    dlg.querySelector('.ed-warn').textContent=warn;
    form.querySelector('button[type=submit]').disabled=!ok;
  }
  form.addEventListener('input',check);
  form.group.addEventListener('change',function(){dlg.querySelector('.ed-newgroup').classList.toggle('hidden-ed',form.group.value!=='__new');check()});
  form.querySelector('[data-x]').addEventListener('click',function(){dlg.close()});
  form.addEventListener('submit',function(e){
    e.preventDefault(); var v=form.url.value.trim(), op;
    if(kind==='post'){
      var url=v.split('?')[0]; if(!/^https?:/.test(url)) url='https://'+url.replace(/^\/+/,'');
      op={op:'addPost',url:url,sec:form.sec.value,handle:(form.handle.value||'').trim().replace(/^@/,''),note:form.note.value.trim()};
    } else if(kind==='acc'){
      var grp=form.group.value==='__new'?form.newgroup.value.trim():form.group.value;
      var tags=form.tags.value.split(',').map(function(t){return t.trim()}).filter(Boolean);
      op={op:'addAcc',handle:handleFrom(v),group:grp,desc:form.desc.value.trim(),tags:tags};
    } else return;
    if(apply(op)){ops.push(op);persist();refresh();showToast('Added',null);
      var el=itemsByKey(op.op==='addPost'?keyOf(op.url):'acc:'+op.handle)[0]; if(el){el.scrollIntoView({block:'center',behavior:'smooth'});el.style.outline='2px solid #405DE6';setTimeout(function(){el.style.outline=''},2000)}}
    dlg.close();
  });
  $('#edAdd').addEventListener('click',function(){form.reset();fillSelects();check();dlg.showModal();form.url.focus()});

  var tt;
  function showToast(msg,undo){
    toast.querySelector('span').textContent=msg;
    var b=toast.querySelector('button');b.style.display=undo?'':'none';b.onclick=function(){undo();toast.style.display='none'};
    toast.style.display='flex';clearTimeout(tt);tt=setTimeout(function(){toast.style.display='none'},5000);
  }

  document.addEventListener('click',function(e){
    var b=e.target.closest('.del-btn'); if(!b) return;
    var el=b.closest('.link-item'), k=itemKey(el), sec=sectionOf(el); if(!k) return;
    var parent=el.parentNode, next=el.nextSibling;
    var op={op:'del',key:k,sec:sec?sec.id:''};
    el.remove(); ops.push(op); persist(); refresh();
    showToast('Deleted',function(){parent.insertBefore(el,next);var i=ops.lastIndexOf(op);if(i>-1)ops.splice(i,1);persist();refresh()});
  });

  function updateSave(){
    var n=ops.length-baked; if(n<0)n=0;
    var s=$('#edSave'); if(!s) return;
    s.classList.toggle('dirty',n>0); s.setAttribute('data-n',n);
  }
  $('#edSave').addEventListener('click',function(){
    var clone=document.documentElement.cloneNode(true);
    ['#edBar','#edDlg','#edToast'].forEach(function(s){var x=clone.querySelector(s);if(x)x.remove()});
    clone.querySelectorAll('.del-btn').forEach(function(x){x.remove()});
    clone.querySelectorAll('.acc-item,.acc-group').forEach(function(x){x.style.display=''; if(!x.getAttribute('style'))x.removeAttribute('style')});
    clone.setAttribute('data-baked',ops.length);
    var html='<!DOCTYPE html>\n'+clone.outerHTML;
    var a=document.createElement('a');a.href=URL.createObjectURL(new Blob([html],{type:'text/html'}));a.download='instagram_saved_sorted.html';
    document.body.appendChild(a);a.click();setTimeout(function(){URL.revokeObjectURL(a.href);a.remove()},1000);
    baked=ops.length; document.documentElement.setAttribute('data-baked',baked); updateSave();
    showToast('Downloaded. Replace your old file with this one.',null);
  });

  /* ---------- init ---------- */
  $$('.link-item').forEach(addDel);
  var changed=false; ops.forEach(function(op){if(apply(op))changed=true});
  if(changed) refresh();
  updateSave();
})();
</script>
</body></html>
